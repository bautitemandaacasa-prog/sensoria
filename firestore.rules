rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Cada reseña se guarda con el uid del usuario como ID del documento.
    // Eso hace que cada persona solo pueda tener UNA reseña (si vuelve a
    // enviar, actualiza la suya) y nunca pueda tocar la de otro.
    match /reviews/{uid} {
      allow read: if true;

      allow create, update: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.uid == uid
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 500;

      allow delete: if false;
    }

    // Todo lo demás, cerrado por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
